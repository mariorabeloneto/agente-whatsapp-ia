# ──────────────────────────────────────────────────────────────
#  Copia este ficheiro para .env e preenche com as tuas credenciais.
#  NUNCA faças commit do .env verdadeiro (está no .gitignore).
# ──────────────────────────────────────────────────────────────

# ── LLM (DeepSeek ou qualquer API compatível com OpenAI) ──
DEEPSEEK_API_KEY=sk-a-tua-chave-aqui
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_URL=https://api.deepseek.com/v1

# ── Histórico de conversas (persistência) ──
#  Aponta para o Redis do stack. Sem isto, o histórico fica em memória.
REDIS_URL=redis://redis:6379/7

# ── Evolution API (gateway WhatsApp) ──
EVOLUTION_URL=http://evolution-api:8080
EVOLUTION_API_KEY=define-uma-api-key-forte
EVOLUTION_INSTANCE=meu-agente

# ── Airtable (CRM de leads) — opcional ──
AIRTABLE_TOKEN=pat-o-teu-token-aqui
AIRTABLE_BASE=app-xxxxxxxxxxxx
AIRTABLE_TABLE=tbl-xxxxxxxxxxxx

# ── Telegram (alertas e handoff do responsável) ──
# Cria um bot próprio no @BotFather e obtém o teu chat_id.
# IMPORTANTE: usa um bot SÓ para este agente (o long-polling precisa de exclusividade).
TELEGRAM_TOKEN=123456789:AA-o-teu-token-aqui
TELEGRAM_CHAT_ID=o-teu-chat-id

# ── Google Calendar (tokens OAuth) ──
# Caminho do ficheiro de tokens usado pelo container (ver volume no docker-compose.yml).
GOOGLE_CALENDAR_TOKENS=/root/.hermes/google_calendar_tokens.json

# ── Privacidade dos traces (RGPD) ──
#  true = os traces NÃO guardam o número em claro nem o texto das mensagens
#  (só um hash e o comprimento). Recomendado em produção.
TRACES_ANONIMIZAR=false
